# LLM API Configuration
# Required for all LLM calls unless OPENAI_API_KEY is provided.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional fallback for embeddings/LLM if OPENROUTER_API_KEY is not set.
# OPENAI_API_KEY=your-openai-api-key

# Optional: custom Qdrant storage path (default: ./qdrant_db)
QDRANT_PATH=./qdrant_db

# Optional debugging for ref resolution logging in src/tools/ref_registry.py
DEBUG_REFS=false
